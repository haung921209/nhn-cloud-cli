          "description": "Comma-separated GSLB IDs (up to 3000)"
        },
        {
          "name": "searchGslbName",
          "in": "query",
          "type": "string",
          "description": "GSLB name to search"
        },
        {
          "name": "gslbDomain",
          "in": "query",
          "type": "string",
          "description": "GSLB domain"
        },
        {
          "name": "showHealthy",
          "in": "query",
          "type": "boolean",
          "description": "Show health check results"
        },
        {
          "name": "page",
          "in": "query",
          "type": "integer",
          "description": "Page number (default 1)"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "description": "Items per page, up to 3000 (default 50)"
        },
        {
          "name": "sortDirection",
          "in": "query",
          "type": "string",
          "description": "DESC (default) or ASC"
        },
        {
          "name": "sortKey",
          "in": "query",
          "type": "string",
          "description": "CREATED_AT, UPDATED_AT, GSLB_NAME, GSLB_DOMAIN, GSLB_TTL, GSLB_ROUTING_RULE or GSLB_DISABLED (default CREATED_AT)"
        }
      ]
    },
    {
      "name": "create-gslb",
      "summary": "Create a GSLB",
      "method": "POST",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/gslbs",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        }
      ],
      "body": {
        "wrapper": "gslb",
        "fields": [
          {
            "name": "gslbName",
            "type": "string",
            "required": true,
            "description": "GSLB name"
          },
          {
            "name": "gslbTtl",
            "type": "integer",
            "required": true,
            "description": "GSLB domain TTL"
          },
          {
            "name": "gslbRoutingRule",
            "type": "string",
            "required": true,
            "description": "FAILOVER, RANDOM or GEOLOCATION"
          },
          {
            "name": "gslbDisabled",
            "type": "boolean",
            "description": "Disable the GSLB (default false)"
          },
          {
            "name": "connectedPoolList",
            "type": "array",
            "description": "Connected pools: [{poolId, connectedPoolOrder, connectedPoolRegionContent}]"
          }
        ]
      }
    },
    {
      "name": "update-gslb",
      "summary": "Update a GSLB and its pool connections",
      "method": "PUT",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/gslbs/{gslbId}",
      "params": [
        {
          "name": "appkey",
          "in": "path",
