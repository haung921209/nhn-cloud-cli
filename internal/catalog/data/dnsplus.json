    {
      "name": "connect-gslb-pool",
      "summary": "Connect a pool to a GSLB",
      "method": "POST",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/gslbs/{gslbId}/connected-pools/{poolId}",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "gslbId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "GSLB ID"
        },
        {
          "name": "poolId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Pool ID"
        }
      ],
      "body": {
        "wrapper": "connectedPool",
        "fields": [
          {
            "name": "connectedPoolOrder",
            "type": "integer",
            "required": true,
            "description": "Pool priority (lower routes first)"
          },
          {
            "name": "connectedPoolRegionContent",
            "type": "string",
            "description": "Comma-separated regions (GEOLOCATION), e.g. NORTHEAST_ASIA,SOUTHEAST_ASIA"
          }
        ]
      }
    },
    {
      "name": "update-gslb-connected-pool",
