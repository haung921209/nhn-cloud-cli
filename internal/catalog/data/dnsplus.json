{
  "name": "dnsplus",
  "title": "Network > DNS Plus",
  "docs": "https://docs.nhncloud.com/ko/Network/DNS%20Plus/ko/api-guide-v2/",
  "version": "v2.0",
  "baseURL": "https://dnsplus.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "X-NHN-AUTHORIZATION": "Bearer {userAccessToken}"
    }
  },
  "operations": [
    {
      "name": "list-zones",
      "summary": "List DNS zones",
      "method": "GET",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneIdList",
          "in": "query",
          "type": "string",
          "description": "Comma-separated zone IDs (up to 3000)"
        },
        {
          "name": "zoneStatusList",
          "in": "query",
          "type": "string",
          "description": "Comma-separated statuses: CREATING, DELETING, DELETING_FAIL, USE"
        },
        {
          "name": "searchZoneName",
          "in": "query",
          "type": "string",
          "description": "Zone name to search"
        },
        {
          "name": "engineId",
          "in": "query",
          "type": "string",
          "description": "DNS server ID"
        },
        {
          "name": "page",
          "in": "query",
          "type": "integer",
          "description": "Page number (default 1)"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "description": "Items per page, up to 3000 (default 50)"
        },
        {
          "name": "sortDirection",
          "in": "query",
          "type": "string",
          "description": "DESC (default) or ASC"
        },
        {
          "name": "sortKey",
          "in": "query",
          "type": "string",
          "description": "CREATED_AT, UPDATED_AT, ZONE_NAME, ZONE_STATUS or RECORDSET_COUNT (default CREATED_AT)"
        }
      ]
    },
    {
      "name": "create-zone",
      "summary": "Create a DNS zone",
      "method": "POST",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        }
      ],
      "body": {
        "wrapper": "zone",
        "fields": [
          {
            "name": "zoneName",
            "type": "string",
            "required": true,
            "description": "Zone name as FQDN (ends with '.')"
          },
          {
            "name": "description",
            "type": "string",
            "description": "Description"
          }
        ]
      }
    },
    {
      "name": "update-zone",
      "summary": "Update a DNS zone description",
      "method": "PUT",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones/{zoneId}",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Zone ID"
        }
      ],
      "body": {
        "wrapper": "zone",
        "fields": [
          {
            "name": "description",
            "type": "string",
            "description": "Description"
          }
        ]
      }
    },
    {
      "name": "delete-zones",
      "summary": "Delete DNS zones and their record sets (asynchronous)",
      "method": "DELETE",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones/async",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneIdList",
          "in": "query",
          "type": "string",
          "description": "Comma-separated zone IDs (up to 3000)",
          "required": true
        }
      ]
    },
    {
      "name": "list-record-sets",
      "summary": "List record sets in a zone",
      "method": "GET",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones/{zoneId}/recordsets",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Zone ID"
        },
        {
          "name": "recordsetIdList",
          "in": "query",
          "type": "string",
          "description": "Comma-separated record set IDs (up to 3000)"
        },
        {
          "name": "recordsetTypeList",
          "in": "query",
          "type": "string",
          "description": "Comma-separated types: A, AAAA, CAA, CNAME, MX, NAPTR, PTR, TXT, SRV, NS, SOA"
        },
        {
          "name": "searchRecordsetName",
          "in": "query",
          "type": "string",
          "description": "Record set name to search"
        },
        {
          "name": "page",
          "in": "query",
          "type": "integer",
          "description": "Page number (default 1)"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "description": "Items per page, up to 3000 (default 50)"
        },
        {
          "name": "sortDirection",
          "in": "query",
          "type": "string",
          "description": "DESC (default) or ASC"
        },
        {
          "name": "sortKey",
          "in": "query",
          "type": "string",
          "description": "CREATED_AT, UPDATED_AT, RECORDSET_NAME, RECORDSET_TYPE or RECORDSET_TTL (default CREATED_AT)"
        }
      ]
    },
    {
      "name": "create-record-set",
      "summary": "Create a record set",
      "method": "POST",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones/{zoneId}/recordsets",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Zone ID"
        }
      ],
      "body": {
        "wrapper": "recordset",
        "fields": [
          {
            "name": "recordsetName",
            "type": "string",
            "required": true,
            "description": "Record set name as FQDN"
          },
          {
            "name": "recordsetType",
            "type": "string",
            "required": true,
            "description": "A, AAAA, CAA, CNAME, MX, NAPTR, PTR, TXT, SRV or NS"
          },
          {
            "name": "recordsetTtl",
            "type": "integer",
            "required": true,
            "description": "TTL in seconds (min 10)"
          },
          {
            "name": "recordList",
            "type": "array",
            "required": true,
            "description": "Records: [{recordDisabled, recordContent}] or type-specific fields"
          }
        ]
      }
    },
    {
      "name": "create-record-sets",
      "summary": "Create up to 2000 record sets",
      "method": "POST",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones/{zoneId}/recordsets/list",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Zone ID"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "recordsetList",
            "type": "array",
            "required": true,
            "description": "Record sets: [{recordsetName, recordsetType, recordsetTtl, recordList}]"
          }
        ]
      }
    },
    {
      "name": "update-record-set",
      "summary": "Update the type, TTL and records of a record set",
      "method": "PUT",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones/{zoneId}/recordsets/{recordsetId}",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Zone ID"
        },
        {
          "name": "recordsetId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Record set ID"
        }
      ],
      "body": {
        "wrapper": "recordset",
        "fields": [
          {
            "name": "recordsetType",
            "type": "string",
            "required": true,
            "description": "A, AAAA, CAA, CNAME, MX, NAPTR, PTR, TXT, SRV or NS"
          },
          {
            "name": "recordsetTtl",
            "type": "integer",
            "required": true,
            "description": "TTL in seconds (min 10)"
          },
          {
            "name": "recordList",
            "type": "array",
            "required": true,
            "description": "Records: [{recordDisabled, recordContent}] or type-specific fields"
          }
        ]
      }
    },
    {
      "name": "delete-record-sets",
      "summary": "Delete record sets",
      "method": "DELETE",
      "path": "/dnsplus/v2.0/appkeys/{appkey}/zones/{zoneId}/recordsets",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "zoneId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Zone ID"
        },
        {
          "name": "recordsetIdList",
          "in": "query",
          "type": "string",
          "description": "Comma-separated record set IDs (up to 3000)",
          "required": true
        }
      ]
    },
    {
      "name": "list-gslbs",
