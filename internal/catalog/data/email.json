          {"name": "requestDate", "type": "string", "description": "Send time (yyyy-MM-dd HH:mm:ss), default now"},
          {"name": "title", "type": "string", "required": true, "description": "Title (up to 998 characters)"},
          {"name": "body", "type": "string", "required": true, "description": "Mail body", "flag": "mail-body"},
          {"name": "templateId", "type": "string", "description": "Template ID"},
          {"name": "receiver", "type": "object", "required": true, "description": "Recipient: receiveMailAddr, receiveName, templateParameter"},
          {"name": "customHeaders", "type": "object", "description": "Custom headers"},
          {"name": "senderGroupingKey", "type": "string", "description": "Sender grouping key (up to 100 characters)"},
          {"name": "userId", "type": "string", "description": "Sender identifier, e.g. admin or system (up to 50 characters)"},
          {"name": "statsId", "type": "string", "description": "Statistics ID"}
        ]
      }
    },
    {
      "name": "upload-attachment",
      "summary": "Upload a mail attachment",
      "method": "POST",
      "path": "/email/v2.1/appKeys/{appKey}/attachfile/binaryUpload",
      "params": [
        {"name": "appKey", "in": "path", "required": true, "credential": "appKey"}
      ],
      "body": {
        "fields": [
          {"name": "fileName", "type": "string", "required": true, "description": "File name"},
          {"name": "fileBody", "type": "array", "required": true, "description": "File content as a byte array"},
          {"name": "createUser", "type": "string", "description": "Uploading user"}
        ]
      }
    },
    {
      "name": "list-mails",
      "summary": "List sent mails; requestId or startSendDate+endSendDate is required",
      "method": "GET",
      "path": "/email/v2.1/appKeys/{appKey}/sender/mails",
      "params": [
        {"name": "appKey", "in": "path", "required": true, "credential": "appKey"},
        {"name": "requestId", "in": "query", "type": "string", "description": "Request ID"},
        {"name": "startSendDate", "in": "query", "type": "string", "description": "Send date from (yyyy-MM-dd HH:mm:ss)"},
        {"name": "endSendDate", "in": "query", "type": "string", "description": "Send date to (yyyy-MM-dd HH:mm:ss)"},
        {"name": "startReceiveDate", "in": "query", "type": "string", "description": "Receive date from (yyyy-MM-dd HH:mm:ss)"},
        {"name": "endReceiveDate", "in": "query", "type": "string", "description": "Receive date to (yyyy-MM-dd HH:mm:ss)"},
        {"name": "senderAddress", "in": "query", "type": "string", "description": "Sender address"},
        {"name": "senderName", "in": "query", "type": "string", "description": "Sender name"},
        {"name": "receiveMailAddr", "in": "query", "type": "string", "description": "Recipient address"},
        {"name": "templateId", "in": "query", "type": "string", "description": "Template ID"},
        {"name": "mailStatusCode", "in": "query", "type": "string", "description": "SST0 ready, SST1 sending, SST2 sent, SST3 failed, SST7 unverified"},
        {"name": "isReceived", "in": "query", "type": "boolean", "description": "Received"},
        {"name": "isOpened", "in": "query", "type": "boolean", "description": "Opened"},
        {"name": "senderGroupingKey", "in": "query", "type": "string", "description": "Sender grouping key"},
        {"name": "pageNum", "in": "query", "type": "integer", "description": "Page number (default 1)"},
        {"name": "pageSize", "in": "query", "type": "integer", "description": "Page size (default 15)"}
      ]
    },
    {
      "name": "get-mail",
      "summary": "Show a sent mail",
      "method": "GET",
      "path": "/email/v2.1/appKeys/{appKey}/sender/mail/{requestId}/{mailSeq}",
      "params": [
        {"name": "appKey", "in": "path", "required": true, "credential": "appKey"},
        {"name": "requestId", "in": "path", "type": "string", "required": true, "description": "Request ID"},
        {"name": "mailSeq", "in": "path", "type": "integer", "required": true, "description": "Mail sequence"}
      ]
    },
    {
      "name": "list-updated-mails",
      "summary": "List mails whose send status was updated in a time range",
      "method": "GET",
      "path": "/email/v2.1/appKeys/{appKey}/sender/update-mails",
      "params": [
        {"name": "appKey", "in": "path", "required": true, "credential": "appKey"},
        {"name": "startMailStatusUpdateDate", "in": "query", "type": "string", "required": true, "description": "Status update time from (yyyy-MM-dd HH:mm:ss)"},
        {"name": "endMailStatusUpdateDate", "in": "query", "type": "string", "required": true, "description": "Status update time to (yyyy-MM-dd HH:mm:ss)"},
        {"name": "mailStatusCode", "in": "query", "type": "string", "description": "SST2 sent, SST3 failed, SST5 rejected, SST7 unverified, SST8 whitelist failure"},
        {"name": "messageType", "in": "query", "type": "string", "description": "NORMAL, DM (advertising) or AUTH"},
        {"name": "pageNum", "in": "query", "type": "integer", "description": "Page number (default 1)"},
        {"name": "pageSize", "in": "query", "type": "integer", "description": "Page size (default 15)"}
      ]
    },
    {
      "name": "list-mass-mails",
      "summary": "List mass mails (the guide marks requestId, startSendDate and endSendDate as required)",
      "method": "GET",
      "path": "/email/v2.1/appKeys/{appKey}/mass-mails",
      "params": [
        {"name": "appKey", "in": "path", "required": true, "credential": "appKey"},
        {"name": "requestId", "in": "query", "type": "string", "description": "Request ID"},
        {"name": "startSendDate", "in": "query", "type": "string", "description": "Send date from (yyyy-MM-dd HH:mm:ss)"},
        {"name": "endSendDate", "in": "query", "type": "string", "description": "Send date to (yyyy-MM-dd HH:mm:ss)"},
        {"name": "senderAddress", "in": "query", "type": "string", "description": "Sender address"},
        {"name": "senderName", "in": "query", "type": "string", "description": "Sender name"},
        {"name": "templateId", "in": "query", "type": "string", "description": "Template ID"},
        {"name": "sendStatus", "in": "query", "type": "string", "description": "WAIT, READY, SENDREADY, SENDWAIT, SENDING, COMPLETE, FAIL, ..."},
        {"name": "pageNum", "in": "query", "type": "integer", "description": "Page number (default 1)"},
        {"name": "pageSize", "in": "query", "type": "integer", "description": "Page size (default 15)"}
      ]
    },
