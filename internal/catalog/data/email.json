{
  "name": "email",
  "title": "Notification > Email",
  "docs": "https://docs.nhncloud.com/ko/Notification/Email/ko/api-guide/",
  "version": "v2.1",
  "baseURL": "https://email.api.nhncloudservice.com",
  "auth": {"headers": {"X-Secret-Key": "{secretKey}"}},
  "operations": [
    {
      "name": "send-mail",
      "summary": "Send a mail",
      "method": "POST",
      "path": "/email/v2.1/appKeys/{appKey}/sender/mail",
      "params": [
        {"name": "appKey", "in": "path", "required": true, "credential": "appKey"}
      ],
      "body": {
        "fields": [
          {"name": "senderAddress", "type": "string", "required": true, "description": "Sender address (up to 100 characters)"},
          {"name": "senderName", "type": "string", "description": "Sender name (up to 100 characters)"},
          {"name": "requestDate", "type": "string", "description": "Send time (yyyy-MM-dd HH:mm:ss), default now"},
          {"name": "title", "type": "string", "required": true, "description": "Title (up to 998 characters)"},
          {"name": "body", "type": "string", "required": true, "description": "Mail body", "flag": "mail-body"},
          {"name": "attachFileIdList", "type": "array", "description": "Uploaded attachment file IDs"},
          {"name": "templateId", "type": "string", "description": "Template ID"},
          {"name": "templateType", "type": "string", "description": "DEFAULT (default) or FREEMARKER"},
          {"name": "templateParameter", "type": "object", "description": "Substitution parameters (##key##)"},
          {"name": "receiverList", "type": "array", "required": true, "description": "Recipients (up to 1,000 including CC): receiveMailAddr, receiveName, receiveType (MRT0 to, MRT1 cc, MRT2 bcc)"},
          {"name": "customHeaders", "type": "object", "description": "Custom headers"},
          {"name": "senderGroupingKey", "type": "string", "description": "Sender grouping key (up to 100 characters)"},
          {"name": "userId", "type": "string", "description": "Sender identifier, e.g. admin or system (up to 50 characters)"},
          {"name": "statsId", "type": "string", "description": "Statistics ID"}
        ]
      }
    },
    {
      "name": "send-each-mail",
      "summary": "Send a separate mail to each recipient",
      "method": "POST",
      "path": "/email/v2.1/appKeys/{appKey}/sender/eachMail",
      "params": [
        {"name": "appKey", "in": "path", "required": true, "credential": "appKey"}
      ],
      "body": {
        "fields": [
          {"name": "senderAddress", "type": "string", "required": true, "description": "Sender address (up to 100 characters)"},
          {"name": "senderName", "type": "string", "description": "Sender name (up to 100 characters)"},
          {"name": "requestDate", "type": "string", "description": "Send time (yyyy-MM-dd HH:mm:ss), default now"},
          {"name": "title", "type": "string", "required": true, "description": "Title (up to 998 characters)"},
          {"name": "body", "type": "string", "required": true, "description": "Mail body", "flag": "mail-body"},
          {"name": "attachFileIdList", "type": "array", "description": "Uploaded attachment file IDs"},
          {"name": "templateId", "type": "string", "description": "Template ID"},
          {"name": "templateType", "type": "string", "description": "DEFAULT (default) or FREEMARKER"},
          {"name": "receiverList", "type": "array", "required": true, "description": "Recipients (up to 1,000): receiveMailAddr, receiveName, templateParameter"},
          {"name": "customHeaders", "type": "object", "description": "Custom headers"},
          {"name": "senderGroupingKey", "type": "string", "description": "Sender grouping key (up to 100 characters)"},
          {"name": "userId", "type": "string", "description": "Sender identifier, e.g. admin or system (up to 50 characters)"},
          {"name": "statsId", "type": "string", "description": "Statistics ID"}
        ]
      }
    },
    {
