    {
      "name": "delete-face",
      "summary": "Delete a face from a group",
      "method": "DELETE",
      "path": "/v2.1/appkeys/{appKey}/groups/{groupId}/faces/{faceId}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "groupId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Group ID ([a-z0-9-], up to 255 chars)"
        },
        {
          "name": "faceId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registered face ID"
        }
      ]
    },
    {
      "name": "list-faces",
      "summary": "List faces in a group",
      "method": "GET",
      "path": "/v2.1/appkeys/{appKey}/groups/{groupId}/faces",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "groupId",
