          "type": "string",
          "required": true,
          "description": "Group ID ([a-z0-9-], up to 255 chars)"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "required": true,
          "description": "Max results (1-200)"
        },
        {
          "name": "face-id",
          "in": "query",
          "type": "string",
          "description": "Face ID"
        },
        {
          "name": "image-id",
          "in": "query",
          "type": "string",
          "description": "Image ID"
        },
        {
          "name": "external-image-id",
          "in": "query",
          "type": "string",
          "description": "User label set at registration"
        },
        {
          "name": "next-token",
          "in": "query",
          "type": "string",
          "description": "Token from the previous page"
        }
      ]
    },
    {
      "name": "search-faces-by-face-id",
      "summary": "Search a group for faces matching a face ID",
      "method": "GET",
      "path": "/v2.1/appkeys/{appKey}/groups/{groupId}/faces/{faceId}/search",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "groupId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Group ID ([a-z0-9-], up to 255 chars)"
        },
        {
          "name": "faceId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registered face ID"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "required": true,
          "description": "Max results (1-4096)"
        },
        {
          "name": "threshold",
          "in": "query",
          "type": "integer",
          "required": true,
          "description": "Similarity threshold (1-100)"
        }
      ]
    },
