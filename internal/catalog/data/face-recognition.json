        "fields": [
          {
            "name": "image",
            "type": "object",
            "required": true,
            "description": "Image: {\"url\": ...} or {\"bytes\": base64}; exactly one"
          },
          {
            "name": "limit",
            "type": "integer",
            "required": true,
            "description": "Max faces to register, largest first (1-20)"
          },
          {
            "name": "externalImageId",
            "type": "string",
            "description": "User label ([a-zA-Z0-9_.-:], up to 255 chars)"
          },
          {
            "name": "orientation",
            "type": "boolean",
            "description": "Detect face orientation (default true)"
          },
          {
            "name": "mask",
            "type": "boolean",
            "description": "Detect mask wearing (default true)"
          }
        ]
      }
    },
