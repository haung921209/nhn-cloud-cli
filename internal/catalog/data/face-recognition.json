{
  "name": "face-recognition",
  "title": "AI Service > Face Recognition",
  "docs": "https://docs.nhncloud.com/ko/AI%20Service/Face%20Recognition/ko/api-guide-v2.1/",
  "version": "v2.1",
  "baseURL": "https://face-recognition.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "x-nhn-authorization": "Bearer {userAccessToken}"
    }
  },
  "operations": [
    {
      "name": "create-group",
      "summary": "Create a face group",
      "method": "POST",
      "path": "/v2.1/appkeys/{appKey}/groups",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "groupId",
            "type": "string",
            "required": true,
            "description": "Group ID ([a-z0-9-], up to 255 chars)"
          }
        ]
      }
    },
    {
      "name": "list-groups",
      "summary": "List face groups",
      "method": "GET",
      "path": "/v2.1/appkeys/{appKey}/groups",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "required": true,
          "description": "Max results (1-200)"
        },
        {
          "name": "next-token",
          "in": "query",
          "type": "string",
          "description": "Token from the previous page"
        }
      ]
    },
    {
      "name": "get-group",
      "summary": "Show a face group",
      "method": "GET",
      "path": "/v2.1/appkeys/{appKey}/groups/{groupId}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "groupId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Group ID ([a-z0-9-], up to 255 chars)"
        }
      ]
    },
    {
      "name": "delete-group",
      "summary": "Delete a face group and its faces",
      "method": "DELETE",
      "path": "/v2.1/appkeys/{appKey}/groups/{groupId}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "groupId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Group ID ([a-z0-9-], up to 255 chars)"
        }
      ]
    },
    {
      "name": "detect-faces",
      "summary": "Detect faces in an image (URL or base64 bytes)",
      "method": "POST",
      "path": "/v2.1/appkeys/{appKey}/faces/detect",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "image",
            "type": "object",
            "required": true,
            "description": "Image: {\"url\": ...} or {\"bytes\": base64}; exactly one"
          },
          {
            "name": "orientation",
            "type": "boolean",
            "description": "Detect face orientation (default true)"
          },
          {
            "name": "mask",
            "type": "boolean",
            "description": "Detect mask wearing (default true)"
          }
        ]
      }
    },
    {
      "name": "detect-faces-file",
      "summary": "Detect faces in an image file",
      "method": "POST",
      "path": "/v2.1/appkeys/{appKey}/faces/detect",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        }
      ],
      "body": {
        "encoding": "multipart",
        "fields": [
          {
            "name": "imageFile",
            "type": "file",
            "required": true,
            "description": "Image file (PNG or JPEG, up to 3MB)"
          },
          {
            "name": "orientation",
            "type": "boolean",
            "description": "Detect face orientation (default true)"
          },
          {
            "name": "mask",
            "type": "boolean",
            "description": "Detect mask wearing (default true)"
          }
        ]
      }
    },
    {
      "name": "register-faces",
      "summary": "Register faces from an image (URL or base64 bytes) to a group",
      "method": "POST",
      "path": "/v2.1/appkeys/{appKey}/groups/{groupId}/faces",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "groupId",
          "in": "path",
