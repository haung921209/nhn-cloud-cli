{
  "name": "iam",
  "title": "NHN Cloud > Public API > Framework API",
  "docs": "https://docs.nhncloud.com/ko/nhncloud/ko/public-api/framework-api/",
  "version": "v1",
  "baseURL": "https://core.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "x-nhn-authorization": "Bearer {userAccessToken}"
    }
  },
  "operations": [
    {
      "name": "create-project-member",
      "summary": "Add a member to a project",
      "method": "POST",
      "path": "/v1/projects/{project-id}/members",
      "params": [
        {"name": "project-id", "in": "path", "type": "string", "required": true, "description": "Project ID"}
      ],
      "body": {
        "fields": [
          {
            "name": "assignRoles",
            "type": "array",
            "required": true,
            "description": "Roles to assign (list of {roleId, conditions})"
          },
          {"name": "memberUuid", "type": "string", "description": "Member UUID"},
          {"name": "email", "type": "string", "description": "Member email"},
          {"name": "userCode", "type": "string", "description": "IAM account ID"}
        ]
      }
    },
    {
      "name": "create-project",
      "summary": "Create a project in an organization",
      "method": "POST",
      "path": "/v1/organizations/{org-id}/projects",
      "params": [
        {"name": "org-id", "in": "path", "type": "string", "required": true, "description": "Organization ID"}
      ],
      "body": {
        "fields": [
          {"name": "description", "type": "string", "description": "Description"},
          {"name": "projectName", "type": "string", "required": true, "description": "Project name (max 40 chars)"}
        ]
      }
    },
    {
      "name": "delete-project-member",
      "summary": "Remove a member from a project",
      "method": "DELETE",
      "path": "/v1/projects/{project-id}/members/{target-uuid}",
      "params": [
        {"name": "project-id", "in": "path", "type": "string", "required": true, "description": "Project ID"},
        {"name": "target-uuid", "in": "path", "type": "string", "required": true, "description": "Member UUID"}
      ]
    },
    {
      "name": "delete-project",
