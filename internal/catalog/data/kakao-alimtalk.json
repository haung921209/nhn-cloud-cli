    {
      "name": "create-alimtalk-template",
      "summary": "Register an AlimTalk template",
      "method": "POST",
      "path": "/alimtalk/v2.3/appkeys/{appkey}/senders/{senderKey}/templates",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "senderKey",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Sender key"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "templateCode",
            "type": "string",
            "required": true,
            "description": "Template code"
          },
          {
            "name": "templateName",
            "type": "string",
            "required": true,
            "description": "Template name"
          },
          {
            "name": "templateContent",
            "type": "string",
            "required": true,
            "description": "Template body (max 1,300 chars)"
          },
          {
            "name": "templateMessageType",
            "type": "string",
            "description": "Message type: BA, EX, AD or MI (default BA)"
          },
          {
            "name": "templateEmphasizeType",
            "type": "string",
            "description": "Emphasis type: NONE, TEXT, IMAGE or ITEM_LIST (default NONE)"
          },
          {
            "name": "templateExtra",
            "type": "string",
            "description": "Extra info (required for EX and MI message types)"
          },
          {
            "name": "templateTitle",
            "type": "string",
            "description": "Template title (max 50 chars)"
          },
          {
            "name": "templateSubtitle",
            "type": "string",
            "description": "Template subtitle (max 50 chars)"
          },
          {
            "name": "templateHeader",
            "type": "string",
            "description": "Template header (max 16 chars)"
          },
          {
            "name": "templateItem",
            "type": "object",
            "description": "Item list"
          },
          {
            "name": "templateItemHighlight",
            "type": "object",
            "description": "Item highlight"
          },
          {
            "name": "templateRepresentLink",
            "type": "object",
            "description": "Representative link"
          },
          {
            "name": "templateImageName",
            "type": "string",
            "description": "Image name (uploaded file name)"
          },
          {
            "name": "templateImageUrl",
            "type": "string",
            "description": "Image URL"
          },
          {
