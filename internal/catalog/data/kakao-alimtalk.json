{
  "name": "kakao",
  "title": "Notification > KakaoTalk Bizmessage > AlimTalk",
  "docs": "https://docs.nhncloud.com/ko/Notification/KakaoTalk%20Bizmessage/ko/alimtalk-api-guide/",
  "version": "v2.3",
  "baseURL": "https://kakaotalk-bizmessage.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "X-Secret-Key": "{secretKey}"
    }
  },
  "operations": [
    {
      "name": "send-alimtalk-messages",
      "summary": "Send AlimTalk messages with template parameter substitution",
      "method": "POST",
      "path": "/alimtalk/v2.3/appkeys/{appkey}/messages",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "X-NC-API-IDEMPOTENCY-KEY",
          "in": "header",
          "type": "string",
          "description": "Idempotency key; the same key within 10 minutes fails the request",
          "flag": "idempotency-key"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "senderKey",
            "type": "string",
            "required": true,
            "description": "Sender key"
          },
          {
            "name": "templateCode",
            "type": "string",
            "required": true,
            "description": "Template code"
          },
          {
            "name": "requestDate",
            "type": "string",
            "description": "Scheduled send time (yyyy-MM-dd HH:mm); omit to send now"
          },
          {
            "name": "senderGroupingKey",
            "type": "string",
            "description": "Sender grouping key (max 100 chars)"
          },
          {
            "name": "createUser",
            "type": "string",
            "description": "Creator (user UUID when sent from the console)"
          },
          {
            "name": "recipientList",
            "type": "array",
            "required": true,
            "description": "Recipients (up to 1,000)"
          },
          {
            "name": "messageOption",
            "type": "object",
            "description": "Message options"
          },
          {
            "name": "statsId",
            "type": "string",
            "description": "Stats ID (max 8 chars)"
          }
        ]
      }
    },
