{
  "name": "kakao",
  "title": "Notification > KakaoTalk Bizmessage > Common",
  "docs": "https://docs.nhncloud.com/ko/Notification/KakaoTalk%20Bizmessage/ko/common-api-guide/",
  "version": "v2.2",
  "baseURL": "https://kakaotalk-bizmessage.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "X-Secret-Key": "{secretKey}"
    }
  },
  "operations": [
    {
      "name": "get-stats",
      "summary": "Show event-based KakaoTalk Bizmessage stats",
      "method": "GET",
      "path": "/common/v2.2/appkeys/{appKey}/stats",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "statsType",
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Stats type"
        },
        {
          "name": "from",
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Start date (yyyy-MM-dd HH:mm:ss)"
        },
        {
          "name": "to",
          "in": "query",
          "type": "string",
          "required": true,
          "description": "End date (yyyy-MM-dd HH:mm:ss)"
        },
        {
          "name": "join",
          "in": "query",
          "type": "boolean",
          "description": "Return stats as a tree"
        },
        {
          "name": "extra1s",
          "in": "query",
          "type": "array",
          "description": "Sub-products: ALIMTALK, ALIMTALK_AUTH, FRIENDTALK, BRAND_MESSAGE"
        },
        {
          "name": "extra2s",
          "in": "query",
          "type": "array",
          "description": "Sender keys"
        },
        {
          "name": "eventTypes",
          "in": "query",
          "type": "array",
          "description": "Event types: REQUESTED, SENT, RECEIVED, SENT_FAILED, RESENT, RESENT_FAILED"
        },
        {
          "name": "eventCategory",
          "in": "query",
          "type": "string",
          "description": "Event category"
        },
        {
          "name": "templateCodes",
          "in": "query",
          "type": "array",
          "description": "Template codes"
        },
        {
          "name": "requestIds",
          "in": "query",
          "type": "array",
          "description": "Request IDs (up to 5)"
        },
        {
          "name": "statsIds",
          "in": "query",
          "type": "array",
          "description": "Stats IDs"
        },
        {
          "name": "statsCriteria",
          "in": "query",
          "type": "array",
          "description": "Stats criteria"
        }
      ]
    },
