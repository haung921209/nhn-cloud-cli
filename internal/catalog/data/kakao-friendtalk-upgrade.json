  "version": "v1.0",
  "baseURL": "https://kakaotalk-bizmessage.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "X-Secret-Key": "{secretKey}"
    }
  },
  "operations": [
    {
      "name": "upload-brand-marketing-agreement",
      "summary": "Upload marketing consent evidence for a brand message sender",
      "method": "POST",
      "path": "/brand-message/v1.0/appkeys/{appKey}/senders/{senderKey}/upload-marketing-agreement",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "senderKey",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Sender key"
        }
      ],
      "body": {
        "encoding": "multipart",
        "fields": [
          {
            "name": "file",
            "type": "file",
            "required": true,
            "description": "Marketing consent evidence file"
          }
        ]
      }
    },
    {
      "name": "request-brand-non-friend-targeting",
      "summary": "Apply for non-friend brand messages (targeting M, N)",
      "method": "POST",
      "path": "/brand-message/v1.0/appkeys/{appKey}/senders/{senderKey}/marketing-agreement",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "senderKey",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Sender key"
        }
      ]
    },
    {
      "name": "send-brand-freestyle-messages",
      "summary": "Send freestyle brand messages (type-specific fields: see API guide)",
      "method": "POST",
      "path": "/brand-message/v1.0/appkeys/{appkey}/freestyle-messages",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "X-NC-API-IDEMPOTENCY-KEY",
          "in": "header",
          "type": "string",
          "description": "Idempotency key; the same key within 10 minutes fails the request",
          "flag": "idempotency-key"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "senderKey",
            "type": "string",
            "required": true,
            "description": "Sender key"
          },
          {
            "name": "chatBubbleType",
            "type": "string",
            "required": true,
            "description": "Message type: TEXT, IMAGE, WIDE, WIDE_ITEM_LIST, PREMIUM_VIDEO, COMMERCE, CAROUSEL_FEED, CAROUSEL_COMMERCE"
          },
          {
            "name": "pushAlarm",
            "type": "boolean",
            "description": "Send a push alarm (default true)"
          },
          {
            "name": "requestDate",
            "type": "string",
            "description": "Scheduled send time (yyyy-MM-dd HH:mm); omit to send now"
          },
          {
            "name": "unsubscribeNo",
            "type": "string",
            "description": "080 unsubscribe phone number"
          },
          {
            "name": "unsubscribeAuthNo",
            "type": "string",
            "description": "080 unsubscribe authentication number (max 10 chars)"
          },
          {
            "name": "adult",
            "type": "boolean",
            "description": "Adult message (default false)"
          },
          {
            "name": "content",
            "type": "string",
            "description": "Message content (required for some types)"
          },
          {
            "name": "buttons",
            "type": "array",
            "description": "Buttons"
          },
          {
            "name": "coupon",
            "type": "object",
            "description": "Coupon element"
          },
          {
            "name": "recipientList",
            "type": "array",
            "required": true,
            "description": "Recipients (up to 1,000)"
          },
          {
            "name": "senderGroupingKey",
            "type": "string",
            "description": "Sender grouping key (max 100 chars)"
          },
          {
            "name": "groupTagKey",
            "type": "string",
            "description": "Group tag key"
          },
          {
            "name": "resellerCode",
            "type": "string",
            "description": "Reseller code"
          },
          {
            "name": "createUser",
            "type": "string",
            "description": "Creator"
          },
          {
            "name": "statsId",
            "type": "string",
            "description": "Stats ID (max 8 chars)"
          },
          {
            "name": "image",
            "type": "object",
            "description": "Image element (IMAGE, WIDE, COMMERCE types)"
          },
          {
            "name": "header",
            "type": "string",
            "description": "Header (WIDE_ITEM_LIST, PREMIUM_VIDEO types)",
            "flag": "message-header"
          },
          {
            "name": "item",
            "type": "object",
            "description": "Wide item list element (WIDE_ITEM_LIST type only)"
          },
          {
            "name": "video",
            "type": "object",
            "description": "Video element (PREMIUM_VIDEO type)"
          },
          {
            "name": "additionalContent",
            "type": "string",
            "description": "Additional info (max 34 chars; commerce type only)"
          },
          {
            "name": "commerce",
            "type": "object",
            "description": "Commerce element (COMMERCE type)"
          },
          {
            "name": "carousel",
            "type": "object",
            "description": "Carousel element (CAROUSEL types)"
          }
        ]
      }
    },
