{
  "name": "kakao",
  "title": "Notification > KakaoTalk Bizmessage > FriendTalk",
  "docs": "https://docs.nhncloud.com/ko/Notification/KakaoTalk%20Bizmessage/ko/friendtalk-api-guide/",
  "version": "v2.4",
  "baseURL": "https://kakaotalk-bizmessage.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "X-Secret-Key": "{secretKey}"
    }
  },
  "operations": [
    {
      "name": "send-friendtalk-messages",
      "summary": "Send FriendTalk messages (recipient fields per message type: see API guide)",
      "method": "POST",
      "path": "/friendtalk/v2.4/appkeys/{appkey}/messages",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "X-NC-API-IDEMPOTENCY-KEY",
          "in": "header",
          "type": "string",
          "description": "Idempotency key; the same key within 10 minutes fails the request",
          "flag": "idempotency-key"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "senderKey",
            "type": "string",
            "required": true,
            "description": "Sender key"
          },
          {
            "name": "requestDate",
            "type": "string",
            "description": "Scheduled send time (yyyy-MM-dd HH:mm); omit to send now"
          },
          {
            "name": "senderGroupingKey",
            "type": "string",
            "description": "Sender grouping key (max 100 chars)"
          },
          {
            "name": "createUser",
            "type": "string",
            "description": "Creator (user UUID when sent from the console)"
          },
          {
            "name": "recipientList",
            "type": "array",
            "required": true,
            "description": "Recipients (up to 1,000)"
          },
          {
            "name": "statsId",
            "type": "string",
            "description": "Stats ID (max 8 chars)"
          }
        ]
      }
    },
    {
      "name": "list-friendtalk-messages",
      "summary": "List FriendTalk messages; requestId, or startRequestDate+endRequestDate, or startCreateDate+endCreateDate is required",
      "method": "GET",
      "path": "/friendtalk/v2.4/appkeys/{appkey}/messages",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "requestId",
          "in": "query",
          "type": "string",
          "description": "Request ID"
        },
        {
          "name": "startRequestDate",
          "in": "query",
          "type": "string",
          "description": "Send request date start (yyyy-MM-dd HH:mm)"
        },
        {
          "name": "endRequestDate",
          "in": "query",
          "type": "string",
          "description": "Send request date end (yyyy-MM-dd HH:mm)"
        },
        {
          "name": "startCreateDate",
          "in": "query",
          "type": "string",
          "description": "Registration date start (yyyy-MM-dd HH:mm)"
        },
        {
          "name": "endCreateDate",
          "in": "query",
          "type": "string",
          "description": "Registration date end (yyyy-MM-dd HH:mm)"
        },
        {
          "name": "recipientNo",
          "in": "query",
          "type": "string",
          "description": "Recipient number"
        },
        {
          "name": "senderKey",
          "in": "query",
          "type": "string",
          "description": "Sender key"
        },
        {
          "name": "senderGroupingKey",
          "in": "query",
          "type": "string",
          "description": "Sender grouping key (max 100 chars)"
        },
        {
          "name": "recipientGroupingKey",
          "in": "query",
          "type": "string",
          "description": "Recipient grouping key"
        },
        {
          "name": "messageStatus",
          "in": "query",
          "type": "string",
          "description": "Request status"
        },
        {
          "name": "resultCode",
          "in": "query",
          "type": "string",
          "description": "Send result: MRC01 (success) or MRC02 (failure)"
        },
        {
          "name": "createUser",
          "in": "query",
          "type": "string",
          "description": "Creator (user UUID when sent from the console)"
        },
        {
          "name": "pageNum",
          "in": "query",
          "type": "integer",
          "description": "Page number (default 1)"
        },
        {
          "name": "pageSize",
          "in": "query",
          "type": "integer",
          "description": "Page size"
        }
      ]
    },
    {
      "name": "get-friendtalk-message",
      "summary": "Show a FriendTalk message",
      "method": "GET",
      "path": "/friendtalk/v2.4/appkeys/{appkey}/messages/{requestId}/{recipientSeq}",
      "params": [
        {
          "name": "appkey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "requestId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Request ID"
        },
        {
          "name": "recipientSeq",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "Recipient sequence number"
        }
      ]
    },
    {
      "name": "cancel-friendtalk-message",
      "summary": "Cancel FriendTalk messages of a request",
