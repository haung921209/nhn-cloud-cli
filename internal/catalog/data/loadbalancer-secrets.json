{
  "name": "loadbalancer",
  "title": "Network > Load Balancer > Secrets and Secret Containers",
  "docs": "https://docs.nhncloud.com/ko/Network/Load%20Balancer/ko/public-api/",
  "version": "v1",
  "iaasServiceType": "key-manager",
  "endpointName": "loadbalancer-secrets",
  "auth": {
    "headers": {
      "X-Auth-Token": "{iaasToken}"
    }
  },
  "operations": [
    {
      "name": "list-secrets",
      "summary": "List secrets",
      "method": "GET",
      "path": "/v1/secrets",
      "params": [
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "description": "Offset of the list (default 0)"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "description": "Maximum number of items (default 10)"
        },
        {
          "name": "name",
          "in": "query",
          "type": "string",
          "description": "Secret name"
        },
        {
          "name": "alg",
          "in": "query",
          "type": "string",
          "description": "Secret algorithm"
        },
        {
          "name": "mode",
          "in": "query",
          "type": "string",
          "description": "Block cipher mode"
        },
        {
          "name": "bits",
          "in": "query",
          "type": "integer",
          "description": "Key length in bits"
        }
      ]
    },
    {
      "name": "get-secret",
      "summary": "Show a secret",
      "method": "GET",
      "path": "/v1/secrets/{secretId}",
      "params": [
        {
          "name": "secretId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Secret ID"
        }
      ]
    },
    {
      "name": "create-secret",
      "summary": "Create a secret (metadata only, or with a payload)",
      "method": "POST",
      "path": "/v1/secrets",
      "body": {
        "fields": [
          {
            "name": "name",
            "type": "string",
            "description": "Secret name"
          },
          {
            "name": "expiration",
            "type": "string",
            "description": "Expiration date (ISO8601)"
          },
          {
            "name": "algorithm",
            "type": "string",
            "description": "Encryption algorithm"
          },
          {
            "name": "bit_length",
            "type": "integer",
            "description": "Key length in bits (the guide's table says String; its examples send a number)"
          },
          {
            "name": "mode",
            "type": "string",
            "description": "Block cipher mode"
          },
          {
            "name": "payload",
            "type": "string",
            "secret": true,
            "description": "Key payload"
          },
          {
            "name": "payload_content_type",
            "type": "string",
            "description": "Payload content type, required with payload: text/plain, application/octet-stream, application/pkcs8, application/pkix-cert"
          },
          {
            "name": "payload_content_encoding",
            "type": "string",
            "description": "Payload encoding, required unless payload_content_type is text/plain: base64"
          },
          {
            "name": "secret_type",
            "type": "string",
            "description": "symmetric, public, private, passphrase, certificate or opaque"
          }
        ]
      }
    },
    {
      "name": "add-secret-payload",
      "summary": "Add the payload of a secret (text/plain by default; pass --header Content-Type:application/octet-stream, application/pkcs8 or application/pkix-cert for the other types)",
      "method": "PUT",
      "path": "/v1/secrets/{secretId}",
      "params": [
        {
          "name": "secretId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Secret ID"
        }
      ],
      "body": {
        "encoding": "raw",
        "contentType": "text/plain"
      }
    },
    {
      "name": "delete-secret",
      "summary": "Delete a secret",
      "method": "DELETE",
      "path": "/v1/secrets/{secretId}",
      "params": [
        {
          "name": "secretId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Secret ID"
        }
      ]
    },
    {
      "name": "list-secret-containers",
      "summary": "List secret containers",
      "method": "GET",
      "path": "/v1/containers",
      "params": [
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "description": "Offset of the list (default 0)"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "description": "Maximum number of items (default 10)"
        }
      ]
    },
    {
      "name": "get-secret-container",
      "summary": "Show a secret container",
      "method": "GET",
      "path": "/v1/containers/{containerId}",
      "params": [
        {
          "name": "containerId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Secret container ID"
        }
      ]
    },
    {
      "name": "create-secret-container",
      "summary": "Create a secret container",
      "method": "POST",
      "path": "/v1/containers",
      "body": {
        "fields": [
          {
            "name": "type",
            "type": "string",
            "required": true,
            "description": "generic, rsa or certificate"
          },
          {
            "name": "name",
            "type": "string",
            "description": "Container name"
          },
          {
            "name": "secret_refs",
            "type": "array",
            "description": "Secrets to register: [{\"name\": ..., \"secret_ref\": ...}] (certificate: certificate, private_key, private_key_passphrase, intermediates; rsa: private_key, private_key_passphrase, public_key); pass with --body"
          }
        ]
      }
    },
    {
      "name": "delete-secret-container",
      "summary": "Delete a secret container",
      "method": "DELETE",
      "path": "/v1/containers/{containerId}",
      "params": [
        {
          "name": "containerId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Secret container ID"
        }
      ]
    }
  ]
}
