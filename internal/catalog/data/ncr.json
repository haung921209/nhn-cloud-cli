{
  "name": "ncr",
  "title": "Container > NHN Container Registry(NCR)",
  "docs": "https://docs.nhncloud.com/ko/Container/NCR/ko/public-api/",
  "version": "v2.0",
  "regionBaseURLs": {
    "kr1": "https://kr1-ncr.api.nhncloudservice.com",
    "kr2": "https://kr2-ncr.api.nhncloudservice.com",
    "kr3": "https://kr3-ncr.api.nhncloudservice.com"
  },
  "auth": {
    "headers": {
      "X-TC-AUTHENTICATION-ID": "{accessKeyId}",
      "X-TC-AUTHENTICATION-SECRET": "{secretAccessKey}"
    }
  },
  "operations": [
    {
      "name": "list-registries",
      "summary": "List container registries",
      "method": "GET",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "page",
          "in": "query",
          "type": "integer",
          "description": "Page number"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "integer",
          "description": "Page size (default 10)"
        }
      ]
    },
    {
      "name": "get-registry",
      "summary": "Show a container registry",
      "method": "GET",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryNameOrId}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryNameOrId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry name or ID"
        },
        {
          "name": "X-Is-Resource-Name",
          "in": "header",
          "type": "string",
          "flag": "is-resource-name",
          "description": "true when registryNameOrId is a name made of digits only"
        }
      ]
    },
    {
      "name": "create-registry",
      "summary": "Create a container registry",
      "method": "POST",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "project_name",
            "type": "string",
            "required": true,
            "description": "Registry name"
          },
          {
            "name": "metadata",
            "type": "object",
            "description": "Registry settings: auto_scan, severity, prevent_vul, reuse_sys_cve_allowlist, enable_content_trust_cosign (string values)"
          },
          {
            "name": "registry_id",
            "type": "integer",
            "description": "Image cache ID, for an image cache registry"
          }
        ]
      }
    },
    {
      "name": "delete-registry",
      "summary": "Delete a container registry",
      "method": "DELETE",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryNameOrId}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryNameOrId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry name or ID"
        },
        {
          "name": "X-Is-Resource-Name",
          "in": "header",
          "type": "string",
          "flag": "is-resource-name",
          "description": "true when registryNameOrId is a name made of digits only"
        }
      ]
    },
    {
      "name": "update-registry",
      "summary": "Change a container registry",
      "method": "PUT",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryNameOrId}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryNameOrId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry name or ID"
        },
        {
          "name": "X-Is-Resource-Name",
          "in": "header",
          "type": "string",
          "flag": "is-resource-name",
          "description": "true when registryNameOrId is a name made of digits only"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "metadata",
            "type": "object",
            "description": "Registry settings: auto_scan, severity, prevent_vul, reuse_sys_cve_allowlist, enable_content_trust_cosign (string values)"
          },
          {
            "name": "cve_allowlist",
            "type": "object",
            "description": "CVE allowlist: items of {cve_id}"
          }
        ]
      }
    },
    {
      "name": "list-immutable-tag-rules",
      "summary": "List image protection (immutable tag) rules",
      "method": "GET",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryId}/immutabletagrules",
