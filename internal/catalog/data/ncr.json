          "required": true,
          "description": "Registry ID"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "tag",
            "type": "object",
            "description": "Tag scope: include, pattern, untagged"
          },
          {
            "name": "scope",
            "type": "object",
            "description": "Image scope: include, pattern"
          },
          {
            "name": "disabled",
            "type": "boolean",
            "description": "Disable the rule (default false)"
          },
          {
            "name": "parameters",
            "type": "object",
            "required": true,
            "description": "Retention settings, e.g. always, latest_pulled_n_images"
          }
        ]
      }
    },
