      "body": {
        "fields": [
          {
            "name": "disabled",
            "type": "boolean",
            "description": "Disable the rule"
          },
          {
            "name": "tag",
            "type": "object",
            "required": true,
            "description": "Tag scope: include, pattern, untagged"
          },
          {
            "name": "scope",
            "type": "object",
            "required": true,
            "description": "Image scope: include, pattern"
          },
          {
            "name": "parameters",
            "type": "object",
            "required": true,
            "description": "Retention settings"
          }
        ]
      }
    },
