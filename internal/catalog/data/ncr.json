        },
        {
          "name": "registryId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry ID"
        },
        {
          "name": "rule_id",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Image cleanup rule ID"
        }
