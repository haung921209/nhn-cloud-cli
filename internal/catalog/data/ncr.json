        },
        {
          "name": "id",
          "in": "query",
          "type": "integer",
          "description": "Image cleanup rule ID",
          "required": true
        }
      ]
    },
    {
      "name": "update-retention-rule",
      "summary": "Change an image cleanup rule",
      "method": "PUT",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryId}/retentions/{rule_id}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
