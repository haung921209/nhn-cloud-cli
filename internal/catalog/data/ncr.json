          "credential": "appKey"
        },
        {
          "name": "registryId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry ID"
        },
        {
          "name": "page",
          "in": "query",
          "type": "integer",
          "description": "Page number"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "integer",
          "description": "Page size (default 10)"
        }
      ]
    },
    {
      "name": "create-immutable-tag-rule",
      "summary": "Create an image protection rule",
      "method": "POST",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryId}/immutabletagrules",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry ID"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "scope",
            "type": "object",
            "description": "Image scope: include, pattern (** for all)"
          },
          {
            "name": "tag",
            "type": "object",
            "description": "Tag scope: include, pattern (** for all)"
          }
        ]
      }
    },
    {
      "name": "delete-immutable-tag-rule",
      "summary": "Delete an image protection rule",
      "method": "DELETE",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryId}/immutabletagrules/{rule_id}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry ID"
        },
        {
          "name": "rule_id",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Image protection rule ID"
        }
      ]
    },
    {
      "name": "update-immutable-tag-rule",
      "summary": "Change an image protection rule",
      "method": "PUT",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryId}/immutabletagrules/{rule_id}",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry ID"
        },
        {
          "name": "rule_id",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Image protection rule ID"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "disabled",
            "type": "boolean",
            "description": "Disable the rule"
          },
          {
            "name": "scope",
            "type": "object",
            "required": true,
            "description": "Image scope: include, pattern"
          },
          {
            "name": "tag",
            "type": "object",
            "required": true,
            "description": "Tag scope: include, pattern"
          }
        ]
      }
    },
    {
      "name": "list-retention-rules",
      "summary": "List image cleanup (retention) rules",
      "method": "GET",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryId}/retentions",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Registry ID"
        },
        {
          "name": "page",
          "in": "query",
          "type": "integer",
          "description": "Page number"
        },
        {
          "name": "page_size",
          "in": "query",
          "type": "integer",
          "description": "Page size (default 10)"
        }
      ]
    },
    {
      "name": "create-retention-rule",
      "summary": "Create an image cleanup rule",
      "method": "POST",
      "path": "/ncr/v2.0/appkeys/{appKey}/registries/{registryId}/retentions",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "registryId",
          "in": "path",
