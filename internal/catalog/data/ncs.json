        }
      ]
    },
    {
      "name": "set-malware-config",
      "summary": "Set the malware scan setting (body fields: see API guide; e.g. --body '{\"enabled\": true}')",
      "method": "POST",
      "path": "/ncs/v1.0/appkeys/{appKey}/malware/config",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
