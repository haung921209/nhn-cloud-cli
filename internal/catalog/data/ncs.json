        },
        {
          "name": "workloadId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Workload ID"
        },
        {
          "name": "historyId",
          "in": "path",
          "type": "integer",
          "required": true,
          "description": "History ID"
        }
      ]
    },
    {
      "name": "list-workload-schedule-history",
      "summary": "List scheduled run history of a workload",
      "method": "GET",
      "path": "/ncs/v1.0/appkeys/{appKey}/workloads/{workloadId}/schedulehistory",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        },
        {
          "name": "workloadId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Workload ID"
        },
        {
          "name": "page",
          "in": "query",
          "type": "integer",
          "description": "Page number"
        },
        {
          "name": "size",
          "in": "query",
          "type": "integer",
          "description": "Page size (default 10)"
        }
      ]
    },
    {
      "name": "create-workload",
      "summary": "Create a workload",
      "method": "POST",
      "path": "/ncs/v1.0/appkeys/{appKey}/workloads",
      "params": [
        {
          "name": "appKey",
          "in": "path",
          "required": true,
          "credential": "appKey"
        }
      ],
      "body": {
        "wrapper": "workload",
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Workload name"
          },
          {
            "name": "type",
            "type": "string",
            "description": "deployment (default) or statefulset"
          },
          {
            "name": "templateId",
            "type": "string",
            "required": true,
            "description": "Template ID"
          },
          {
            "name": "templateVersion",
            "type": "string",
            "description": "Template version (default latest)"
          },
          {
            "name": "desired",
            "type": "integer",
            "required": true,
            "description": "Desired task count"
          },
          {
            "name": "internalLBTimeout",
            "type": "integer",
            "description": "Internal request timeout"
          },
          {
            "name": "loadBalancing",
            "type": "object",
            "required": true,
            "description": "Load balancer settings: enabled, floatingIp, healthMonitor, ... (see API guide)"
          },
          {
            "name": "schedule",
            "type": "object",
            "description": "Scheduled run: timeZone, cron, jobsHistoryLimit, concurrencyPolicy"
          },
          {
            "name": "internalLoadBalancing",
            "type": "object",
            "description": "Internal load balancer settings"
          },
          {
            "name": "privateDns",
            "type": "object",
            "description": "Register task IPs in Private DNS: ttl, zoneId, domain"
          },
          {
            "name": "activeDeadline",
            "type": "object",
            "description": "Scheduled stop: timeZone, timeOffset, time"
          },
          {
            "name": "autoScaler",
            "type": "object",
            "description": "Autoscaler: scaleOut, scaleIn"
          },
          {
            "name": "securityGroups",
            "type": "array",
            "description": "Security groups: objects with id"
          }
        ]
      }
    },
    {
      "name": "update-workload",
      "summary": "Change a workload",
      "method": "PUT",
      "path": "/ncs/v1.0/appkeys/{appKey}/workloads/{workloadId}",
