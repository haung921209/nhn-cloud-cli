{
  "name": "nks",
  "title": "Container > NHN Kubernetes Service(NKS)",
  "docs": "https://docs.nhncloud.com/ko/Container/NKS/ko/public-api/",
  "version": "v2",
  "regionBaseURLs": {
    "kr1": "https://kr1-api-kubernetes-infrastructure.nhncloudservice.com",
    "kr2": "https://kr2-api-kubernetes-infrastructure.nhncloudservice.com",
    "kr3": "https://kr3-api-kubernetes-infrastructure.nhncloudservice.com"
  },
  "auth": {
    "headers": {
      "X-Auth-Token": "{iaasToken}",
      "OpenStack-API-Version": "container-infra latest",
      "Accept": "application/json"
    }
  },
  "operations": [
    {
      "name": "list-clusters",
      "summary": "List clusters",
      "method": "GET",
      "path": "/v1/clusters"
    },
    {
      "name": "get-cluster",
      "summary": "Show a cluster",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ]
    },
    {
      "name": "list-cluster-events",
      "summary": "List the operation history of a cluster",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_UUID}/events",
      "params": [
        {
          "name": "CLUSTER_UUID",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID"
        }
      ]
    },
    {
      "name": "get-cluster-event",
      "summary": "Show one operation history entry of a cluster",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_UUID}/events/{EVENT_UUID}",
      "params": [
        {
          "name": "CLUSTER_UUID",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID"
        },
        {
          "name": "EVENT_UUID",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Event UUID"
        }
      ]
    },
    {
      "name": "create-cluster",
      "summary": "Create a cluster (node_count is also required: guide types it String but shows a number, pass it with --body; labels and addons: see API guide)",
      "method": "POST",
      "path": "/v1/clusters",
      "body": {
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Cluster name"
          },
          {
            "name": "cluster_template_id",
            "type": "string",
            "required": true,
            "description": "Cluster template ID; must be iaas_console"
          },
          {
            "name": "keypair",
            "type": "string",
            "required": true,
            "description": "Key pair name for the default worker node group"
          },
          {
            "name": "flavor_id",
            "type": "string",
            "required": true,
            "description": "Instance type UUID for the default worker node group"
          },
          {
            "name": "fixed_network",
            "type": "string",
            "required": true,
            "description": "VPC network UUID"
          },
          {
            "name": "fixed_subnet",
            "type": "string",
            "required": true,
            "description": "VPC subnet UUID"
          },
          {
            "name": "labels",
            "type": "object",
            "required": true,
            "description": "Cluster creation labels (see API guide)"
          },
          {
            "name": "addons",
            "type": "array",
            "description": "Add-ons to install: objects with name, version, options"
          }
        ]
      }
    },
    {
      "name": "delete-cluster",
      "summary": "Delete a cluster",
      "method": "DELETE",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ]
    },
    {
      "name": "resize-cluster",
      "summary": "Change the node count of a worker node group",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/actions/resize",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "nodegroup",
            "type": "string",
            "required": true,
            "description": "Target worker node group name or UUID"
          },
          {
            "name": "node_count",
            "type": "integer",
            "required": true,
            "description": "New worker node count"
          },
          {
            "name": "nodes_to_remove",
            "type": "array",
            "items": "string",
            "description": "Node UUIDs to remove when scaling in"
          }
        ]
      }
    },
    {
      "name": "get-cluster-kubeconfig",
      "summary": "Show the kubeconfig of a cluster",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/config",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ]
    },
    {
      "name": "set-cluster-api-ipacl",
      "summary": "Apply or remove IP access control on the cluster API endpoint",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/api_ep_ipacl",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "enable",
            "type": "string",
            "required": true,
            "description": "true or false (default false)"
          },
          {
            "name": "action",
            "type": "string",
            "description": "ALLOW or DENY (required when enable is true)"
          },
          {
            "name": "ipacl_targets",
            "type": "array",
            "description": "Targets: objects with cidr_address (required when enable is true)"
          }
        ]
      }
    },
    {
      "name": "get-cluster-api-ipacl",
      "summary": "Show the IP access control of the cluster API endpoint",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/api_ep_ipacl",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ]
    },
    {
      "name": "renew-cluster-certificates",
      "summary": "Renew the certificates of a cluster",
      "method": "PATCH",
      "path": "/v1/certificates/{CLUSTER_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "term_of_validity",
            "type": "integer",
            "required": true,
            "description": "Validity in years (1-5)"
          }
        ]
      }
    },
    {
      "name": "update-cluster-service-gateways",
      "summary": "Change the service gateways of a cluster",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/actions/update_sgw",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "ncr_sgw",
            "type": "string",
            "required": true,
            "description": "NCR-type service gateway UUID"
          },
          {
            "name": "obs_sgw",
            "type": "string",
            "required": true,
            "description": "OBS-type service gateway UUID"
          }
        ]
      }
    },
    {
      "name": "set-cluster-control-plane-log",
      "summary": "Configure saving control plane component logs (control_plane_log object: see API guide)",
      "method": "PATCH",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "type",
            "type": "string",
            "required": true,
            "description": "Must be control_plane_log"
          },
          {
            "name": "control_plane_log",
            "type": "object",
            "required": true,
            "description": "enable, type (lncs or obs), sgw and related settings"
          }
        ]
      }
    },
    {
      "name": "list-node-groups",
      "summary": "List node groups of a cluster",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ]
    },
    {
      "name": "get-node-group",
      "summary": "Show a node group",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ]
    },
    {
      "name": "create-node-group",
      "summary": "Create a node group (labels: see API guide)",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Node group name"
          },
          {
            "name": "flavor_id",
            "type": "string",
            "required": true,
            "description": "Instance type UUID"
          },
          {
            "name": "image_id",
            "type": "string",
            "required": true,
            "description": "Base image UUID"
          },
          {
            "name": "node_count",
            "type": "integer",
            "description": "Node count (default 1)"
          },
          {
            "name": "labels",
            "type": "object",
            "required": true,
            "description": "Node group creation labels (see API guide)"
          }
        ]
      }
    },
    {
      "name": "delete-node-group",
      "summary": "Delete a node group",
      "method": "DELETE",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ]
    },
    {
      "name": "stop-nodes",
      "summary": "Stop nodes of a node group",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}/stop_node",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "node_list",
            "type": "string",
            "required": true,
            "description": "Node instance UUIDs separated by colons"
          }
        ]
      }
    },
    {
      "name": "start-nodes",
      "summary": "Start nodes of a node group",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}/start_node",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "node_list",
            "type": "string",
            "required": true,
            "description": "Node instance UUIDs separated by colons"
          }
        ]
      }
    },
    {
      "name": "get-node-group-autoscale",
      "summary": "Show the cluster autoscaler settings of a node group",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}/autoscale",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ]
    },
    {
      "name": "set-node-group-autoscale",
      "summary": "Change the cluster autoscaler settings of a node group (body fields: see API guide; ca_enable is required)",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}/autoscale",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {}
    },
    {
      "name": "set-node-group-metric-autoscale",
      "summary": "Change the metric-based autoscaler settings of a node group",
      "method": "PATCH",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "type",
            "type": "string",
            "required": true,
            "description": "Must be metric_base_autoscale"
          },
          {
            "name": "mba_scale_out",
            "type": "object",
            "description": "Scale-out policy (see API guide)"
          },
          {
            "name": "mba_scale_in",
            "type": "object",
            "description": "Scale-in policy (see API guide)"
          }
        ]
      }
    },
    {
      "name": "upgrade-node-group",
      "summary": "Upgrade the Kubernetes version of a node group (default-master for the control plane)",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}/upgrade",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name; default-master for the control plane"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "version",
            "type": "string",
            "required": true,
            "description": "Kubernetes version"
          },
          {
            "name": "num_buffer_nodes",
            "type": "integer",
            "description": "Buffer node count (default 1)"
          },
          {
            "name": "num_max_unavailable_nodes",
            "type": "integer",
            "description": "Max unavailable node count (default 1)"
          }
        ]
      }
    },
    {
      "name": "set-node-group-user-script",
      "summary": "Change the user script of a node group",
      "method": "POST",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}/userscript",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "contents",
            "type": "string",
            "required": true,
            "description": "User script contents"
          }
        ]
      }
    },
    {
      "name": "set-node-group-flavor",
      "summary": "Change the instance type of a node group",
      "method": "PATCH",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "type",
            "type": "string",
            "required": true,
            "description": "Must be flavor_id"
          },
          {
            "name": "flavor_id",
            "type": "string",
            "required": true,
            "description": "Instance type UUID"
          },
          {
            "name": "num_buffer_nodes",
            "type": "integer",
            "description": "Buffer node count (default 1)"
          },
          {
            "name": "num_max_unavailable_nodes",
            "type": "integer",
            "description": "Max unavailable node count (default 1)"
          }
        ]
      }
    },
    {
      "name": "set-node-group-fip-auto-bind",
      "summary": "Change the floating IP auto-bind settings of a node group",
      "method": "PATCH",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "type",
            "type": "string",
            "required": true,
            "description": "Must be fip_auto_bind"
          },
          {
            "name": "fip_auto_bind_update_info",
            "type": "object",
            "required": true,
            "description": "fip_auto_bind_enable, fip_bind_subnet, fip_selector"
          }
        ]
      }
    },
    {
      "name": "set-node-group-k8s-labels",
      "summary": "Change the Kubernetes labels of a node group",
      "method": "PATCH",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/nodegroups/{NODEGROUP_ID_OR_NAME}",
      "params": [
        {
          "name": "CLUSTER_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Cluster UUID or name"
        },
        {
          "name": "NODEGROUP_ID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Node group UUID or name"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "type",
            "type": "string",
            "required": true,
            "description": "Must be k8s_node_labels"
          },
          {
            "name": "k8s_node_labels",
            "type": "object",
            "required": true,
            "description": "Label key-value pairs (up to 20)"
          }
        ]
      }
    },
    {
      "name": "get-addon-type",
      "summary": "Show an add-on type provided by NHN Cloud",
      "method": "GET",
      "path": "/v1/addon_types/{ADDON_TYPE_UUID_OR_NAME}",
      "params": [
        {
          "name": "ADDON_TYPE_UUID_OR_NAME",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Add-on type UUID or name"
        }
      ]
    },
    {
      "name": "list-addon-types",
      "summary": "List add-on types provided by NHN Cloud",
      "method": "GET",
      "path": "/v1/addon_types"
    },
    {
      "name": "get-addon",
      "summary": "Show an add-on provided by NHN Cloud",
      "method": "GET",
      "path": "/v1/addons/{ADDON_UUID}",
      "params": [
        {
          "name": "ADDON_UUID",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Add-on UUID"
        }
      ]
    },
    {
      "name": "list-addons",
      "summary": "List add-ons provided by NHN Cloud",
      "method": "GET",
      "path": "/v1/addons",
      "params": [
        {
          "name": "k8s_version",
          "in": "query",
          "type": "string",
          "description": "Only add-ons compatible with this Kubernetes version"
        },
        {
          "name": "image",
          "in": "query",
          "type": "string",
          "description": "Only add-ons installable on this base image UUID"
        },
        {
          "name": "platform_version",
          "in": "query",
          "type": "string",
          "description": "Only add-ons available on this platform version"
        }
      ]
    },
    {
      "name": "get-cluster-addon",
      "summary": "Show an add-on installed in a cluster",
      "method": "GET",
      "path": "/v1/clusters/{CLUSTER_ID_OR_NAME}/addons/{ADDON_UUID_OR_NAME}",
      "params": [
        {
