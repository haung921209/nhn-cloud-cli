{
  "name": "notification-hub",
  "title": "Notification > Notification Hub > Kakao Statistics",
  "docs": "https://docs.nhncloud.com/ko/Notification/Notification%20Hub/ko/api-guide-v1x0/kakao-statistics/",
  "version": "v1.0",
  "baseURL": "https://notification-hub.api.nhncloudservice.com",
  "auth": {
    "headers": {
      "X-NC-APP-KEY": "{appKey}",
      "X-NHN-Authorization": "Bearer {userAccessToken}"
    }
  },
  "operations": [
    {
      "name": "get-alimtalk-delivery-stats",
      "summary": "Show Kakao AlimTalk delivery stats (range up to 3 months)",
      "method": "GET",
      "path": "/kakaobizcenter/v1.0/kakao-statistics/delivery-statistics/ALIMTALK",
      "params": [
        {
          "name": "senderKey",
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Sender key"
        },
        {
          "name": "periodType",
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Period: DAILY or MONTHLY"
        },
        {
          "name": "startDate",
          "in": "query",
          "type": "string",
          "required": true,
          "description": "Start date"
        },
        {
          "name": "endDate",
          "in": "query",
          "type": "string",
          "required": true,
          "description": "End date"
        },
        {
          "name": "messageType",
          "in": "query",
          "type": "string",
          "description": "Message type"
        },
        {
          "name": "receiveUserType",
          "in": "query",
          "type": "string",
          "description": "Recipient identifier type"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "description": "Number of items to return"
        },
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "description": "Start offset (default 0)"
        }
      ]
    },
