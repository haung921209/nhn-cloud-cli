  "operations": [
    {
      "name": "send-sms-message",
      "summary": "Send a free-form SMS message",
      "method": "POST",
      "path": "/message/v1.0/SMS/free-form-messages/{messagePurpose}",
      "params": [
        {
          "name": "messagePurpose",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Message purpose: NORMAL, AD or AUTH"
        }
      ],
      "body": {
        "fields": [
          {
            "name": "sender",
            "type": "object",
            "required": true,
            "description": "Sender"
          },
          {
            "name": "recipients",
            "type": "array",
            "required": true,
            "description": "Recipients"
          },
          {
            "name": "content",
            "type": "object",
            "required": true,
            "description": "Message content"
          },
          {
            "name": "statsKeyId",
            "type": "string",
            "description": "Stats key ID"
          },
          {
            "name": "scheduledDateTime",
            "type": "string",
            "description": "Scheduled send time"
          },
          {
            "name": "confirmBeforeSend",
            "type": "boolean",
            "description": "Send only after confirmation"
          }
        ]
      }
    },
