    {
      "name": "list-alimtalk-kakao-templates",
      "summary": "List Kakao templates of an AlimTalk template",
      "method": "GET",
      "path": "/template/v1.0/ALIMTALK/templates/{templateId}/kakao-templates",
      "params": [
        {
          "name": "templateId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Template ID"
        },
        {
          "name": "limit",
          "in": "query",
          "type": "integer",
          "description": "Number of items to return"
        },
        {
          "name": "offset",
          "in": "query",
          "type": "integer",
          "description": "Start offset (default 0)"
        }
      ]
    },
    {
      "name": "create-kakao-template-inquiry-with-file",
      "summary": "Send an inquiry with a file about a Kakao AlimTalk template",
      "method": "POST",
      "path": "/template/v1.0/ALIMTALK/templates/{templateId}/kakao-templates/{kakaoTemplateCode}/inquiries/do-with-file",
      "params": [
        {
          "name": "templateId",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Template ID"
        },
        {
          "name": "kakaoTemplateCode",
          "in": "path",
          "type": "string",
          "required": true,
          "description": "Kakao template code"
        }
      ],
      "body": {
        "encoding": "multipart",
        "fields": [
          {
            "name": "file",
            "type": "file",
            "required": true,
            "description": "Inquiry file (one file per call)"
          },
          {
            "name": "comment",
            "type": "string",
            "required": true,
            "description": "Inquiry text"
          }
        ]
      }
    },
