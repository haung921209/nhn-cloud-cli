      "params": [
        {"name": "messageId", "in": "path", "type": "string", "required": true, "description": "Message ID"}
      ]
    },
    {
      "name": "upload-media",
      "summary": "Upload an attachment (jpg, jpeg, png, gif, bmp; up to 1MB; kept 7 days)",
      "method": "POST",
      "path": "/rcs/v1.0/media",
      "body": {
        "encoding": "multipart",
        "fields": [
          {"name": "uploadFile", "type": "file", "required": true, "description": "File to upload"},
          {"name": "uploadUser", "type": "string", "description": "Uploading user name"}
        ]
      }
    }
  ]
}
