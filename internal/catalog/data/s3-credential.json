{
  "name": "s3-credential",
  "title": "Public API > S3 API Credential",
  "docs": "https://docs.nhncloud.com/ko/nhncloud/ko/public-api/s3-api-credential/",
  "version": "v2.0",
  "baseURL": "https://api-identity-infrastructure.nhncloudservice.com",
  "auth": {
    "headers": {
      "X-Auth-Token": "{iaasToken}"
    }
  },
  "operations": [
    {
      "name": "create-credential",
      "summary": "Issue an S3 API credential (up to 3 per user per project)",
      "method": "POST",
      "path": "/v2.0/users/{user-id}/credentials/OS-EC2",
      "params": [
        {"name": "user-id", "in": "path", "type": "string", "description": "API user ID", "required": true}
      ],
      "body": {
        "fields": [
          {"name": "tenant_id", "type": "string", "description": "Tenant ID", "required": true, "flag": "credential-tenant-id"}
        ]
      }
    },
    {
      "name": "list-credentials",
      "summary": "List S3 API credentials",
      "method": "GET",
      "path": "/v2.0/users/{user-id}/credentials/OS-EC2",
      "params": [
        {"name": "user-id", "in": "path", "type": "string", "description": "API user ID", "required": true}
      ]
    },
    {
      "name": "delete-credential",
      "summary": "Delete an S3 API credential",
      "method": "DELETE",
      "path": "/v2.0/users/{user-id}/credentials/OS-EC2/{access}",
      "params": [
        {"name": "user-id", "in": "path", "type": "string", "description": "API user ID", "required": true},
        {"name": "access", "in": "path", "type": "string", "description": "S3 API access key", "required": true}
      ]
    }
  ]
}
