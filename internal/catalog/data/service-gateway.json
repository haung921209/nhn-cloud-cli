{
  "name": "service-gateway",
  "aliases": ["svcgw", "sg-gateway"],
  "title": "Network > Service Gateway",
  "docs": "https://docs.nhncloud.com/ko/Network/Service%20Gateway/ko/public-api/",
  "version": "v2.0",
  "iaasServiceType": "network",
  "auth": {"headers": {"X-Auth-Token": "{iaasToken}"}},
  "operations": [
    {
      "name": "list-service-gateways",
      "summary": "List service gateways",
      "method": "GET",
      "path": "/v2.0/gateways/servicegateways",
      "params": [
        {"name": "id", "in": "query", "type": "string", "description": "Service gateway ID"},
        {"name": "name", "in": "query", "type": "string", "description": "Service gateway name"},
        {"name": "service_endpoint_id", "in": "query", "type": "string", "description": "Service endpoint (or user-defined endpoint) ID"},
        {"name": "network_id", "in": "query", "type": "string", "description": "VPC ID"},
        {"name": "subnet_id", "in": "query", "type": "string", "description": "Subnet ID"},
        {"name": "port_id", "in": "query", "type": "string", "description": "Port ID"},
        {"name": "fixed_ip", "in": "query", "type": "string", "description": "IP address"},
        {"name": "include_gateway_identity", "in": "query", "type": "boolean", "description": "Fixed NAT IP address in use"}
      ]
    },
    {
      "name": "get-service-gateway",
      "summary": "Show a service gateway",
      "method": "GET",
      "path": "/v2.0/gateways/servicegateways/{serviceGatewayId}",
      "params": [
        {"name": "serviceGatewayId", "in": "path", "type": "string", "required": true, "description": "Service gateway ID"}
      ]
    },
    {
      "name": "create-service-gateway",
      "summary": "Create a service gateway",
      "method": "POST",
      "path": "/v2.0/gateways/servicegateways",
      "body": {
        "wrapper": "servicegateway",
        "fields": [
          {"name": "name", "type": "string", "description": "Service gateway name"},
          {"name": "description", "type": "string", "description": "Description"},
          {"name": "network_id", "type": "string", "required": true, "description": "VPC ID"},
          {"name": "subnet_id", "type": "string", "required": true, "description": "Subnet ID"},
          {"name": "fixed_ip", "type": "string", "description": "IP address"},
          {"name": "include_gateway_identity", "type": "boolean", "description": "Use a fixed NAT IP address"},
          {"name": "service_endpoint_id", "type": "string", "required": true, "description": "Service endpoint (or user-defined endpoint) ID; for a user-defined one, look it up with list-service-endpoints --service-name"}
        ]
      }
    },
    {
      "name": "update-service-gateway",
      "summary": "Change the name or description of a service gateway",
      "method": "PUT",
      "path": "/v2.0/gateways/servicegateways/{serviceGatewayId}",
      "params": [
        {"name": "serviceGatewayId", "in": "path", "type": "string", "required": true, "description": "Service gateway ID"}
      ],
      "body": {
        "wrapper": "servicegateway",
        "fields": [
          {"name": "name", "type": "string", "description": "Service gateway name"},
          {"name": "description", "type": "string", "description": "Description"}
        ]
      }
    },
    {
      "name": "delete-service-gateway",
      "summary": "Delete a service gateway",
      "method": "DELETE",
      "path": "/v2.0/gateways/servicegateways/{serviceGatewayId}",
      "params": [
        {"name": "serviceGatewayId", "in": "path", "type": "string", "required": true, "description": "Service gateway ID"}
      ]
    },
    {
      "name": "list-service-endpoints",
      "summary": "List service endpoints",
      "method": "GET",
      "path": "/v2.0/gateways/serviceendpoints/",
      "params": [
        {"name": "id", "in": "query", "type": "string", "description": "Service endpoint ID"},
        {"name": "display_name", "in": "query", "type": "string", "description": "Service endpoint name"},
        {"name": "service_name", "in": "query", "type": "string", "description": "Service name from a user-defined endpoint publisher ({region}.sep-{12 hex})"}
      ]
    },
    {
      "name": "get-service-endpoint",
      "summary": "Show a service endpoint",
      "method": "GET",
      "path": "/v2.0/gateways/serviceendpoints/{serviceEndpointId}",
      "params": [
        {"name": "serviceEndpointId", "in": "path", "type": "string", "required": true, "description": "Service endpoint ID"}
      ]
    },
    {
      "name": "list-my-service-endpoints",
      "summary": "List user-defined service endpoints of this project",
      "method": "GET",
      "path": "/v2.0/gateways/myserviceendpoints",
      "params": [
        {"name": "id", "in": "query", "type": "string", "description": "User-defined endpoint ID"},
        {"name": "endpoint_type", "in": "query", "type": "string", "description": "Endpoint type (e.g. lb.type1)"},
        {"name": "port_id", "in": "query", "type": "string", "description": "Target resource (load balancer) port ID"}
      ]
    },
    {
      "name": "get-my-service-endpoint",
      "summary": "Show a user-defined service endpoint",
      "method": "GET",
      "path": "/v2.0/gateways/myserviceendpoints/{serviceEndpointId}",
      "params": [
        {"name": "serviceEndpointId", "in": "path", "type": "string", "required": true, "description": "User-defined endpoint ID"}
      ]
    },
    {
      "name": "create-my-service-endpoint",
      "summary": "Create a user-defined service endpoint for a load balancer",
      "method": "POST",
      "path": "/v2.0/gateways/myserviceendpoints",
      "body": {
        "wrapper": "myserviceendpoint",
        "fields": [
          {"name": "name", "type": "string", "required": true, "description": "Name (up to 255 chars, letters, digits, - and _)"},
          {"name": "display_name", "type": "string", "description": "Display name (default: name)"},
          {"name": "port_id", "type": "string", "required": true, "description": "Load balancer port ID (vip_port_id of the load balancer)"},
          {"name": "max_count", "type": "integer", "description": "Maximum gateways (0-1000; 0 blocks, omitted is unlimited)"},
          {"name": "description", "type": "string", "description": "Description"}
        ]
      }
    },
    {
      "name": "update-my-service-endpoint",
      "summary": "Change a user-defined service endpoint",
      "method": "PUT",
      "path": "/v2.0/gateways/myserviceendpoints/{serviceEndpointId}",
      "params": [
        {"name": "serviceEndpointId", "in": "path", "type": "string", "required": true, "description": "User-defined endpoint ID"}
      ],
      "body": {
        "wrapper": "myserviceendpoint",
        "fields": [
          {"name": "name", "type": "string", "description": "Name"},
          {"name": "display_name", "type": "string", "description": "Display name"},
          {"name": "max_count", "type": "integer", "description": "Maximum gateways (0-1000; 0 blocks; null via --body is unlimited)"},
          {"name": "description", "type": "string", "description": "Description"}
        ]
      }
    },
    {
      "name": "delete-my-service-endpoint",
      "summary": "Delete a user-defined service endpoint (fails while a service gateway uses it)",
      "method": "DELETE",
      "path": "/v2.0/gateways/myserviceendpoints/{serviceEndpointId}",
      "params": [
        {"name": "serviceEndpointId", "in": "path", "type": "string", "required": true, "description": "User-defined endpoint ID"}
      ]
    },
    {
      "name": "regenerate-service-endpoint-name",
      "summary": "Issue a new service name for a user-defined service endpoint (owner only)",
      "method": "PUT",
      "path": "/v2.0/gateways/serviceendpoints/{serviceEndpointId}/generate_service_name",
      "params": [
        {"name": "serviceEndpointId", "in": "path", "type": "string", "required": true, "description": "User-defined endpoint ID"}
      ]
    },
    {
      "name": "list-endpoint-allowed-projects",
      "summary": "List projects allowed to use user-defined service endpoints",
      "method": "GET",
      "path": "/v2.0/gateways/serviceendpointallowprojects",
      "params": [
        {"name": "service_endpoint_id", "in": "query", "type": "string", "description": "User-defined endpoint ID"},
        {"name": "target_tenant_id", "in": "query", "type": "string", "description": "Allowed tenant ID"}
      ]
    },
    {
      "name": "get-endpoint-allowed-project",
      "summary": "Show an allowed project entry",
      "method": "GET",
      "path": "/v2.0/gateways/serviceendpointallowprojects/{allowProjectId}",
      "params": [
        {"name": "allowProjectId", "in": "path", "type": "string", "required": true, "description": "Allowed project ID"}
      ]
    },
    {
      "name": "add-endpoint-allowed-project",
      "summary": "Allow a project to use a user-defined service endpoint",
      "method": "POST",
      "path": "/v2.0/gateways/serviceendpointallowprojects",
      "body": {
        "wrapper": "serviceendpointallowproject",
        "fields": [
          {"name": "service_endpoint_id", "type": "string", "required": true, "description": "User-defined endpoint ID"},
          {"name": "target_tenant_id", "type": "string", "required": true, "description": "* for all projects, or a tenant ID (32 hex)"},
          {"name": "name", "type": "string", "description": "Name (for reference)"},
          {"name": "description", "type": "string", "description": "Description"}
        ]
      }
    },
    {
      "name": "update-endpoint-allowed-project",
      "summary": "Rename or describe an allowed project entry",
      "method": "PUT",
      "path": "/v2.0/gateways/serviceendpointallowprojects/{allowProjectId}",
      "params": [
        {"name": "allowProjectId", "in": "path", "type": "string", "required": true, "description": "Allowed project ID"}
      ],
      "body": {
        "wrapper": "serviceendpointallowproject",
        "fields": [
          {"name": "name", "type": "string", "description": "Name (for reference)"},
          {"name": "description", "type": "string", "description": "Description"}
        ]
      }
    },
    {
      "name": "remove-endpoint-allowed-project",
      "summary": "Stop allowing a project to use a user-defined service endpoint",
      "method": "DELETE",
      "path": "/v2.0/gateways/serviceendpointallowprojects/{allowProjectId}",
      "params": [
        {"name": "allowProjectId", "in": "path", "type": "string", "required": true, "description": "Allowed project ID"}
      ]
    },
    {
      "name": "list-service-endpoint-usages",
      "summary": "List service gateways that use this project's user-defined endpoints",
      "method": "GET",
      "path": "/v2.0/gateways/serviceendpointusages",
      "params": [
        {"name": "id", "in": "query", "type": "string", "description": "User-defined endpoint ID (default: all owned endpoints)"},
        {"name": "network_id", "in": "query", "type": "string", "description": "Service gateway VPC ID"},
        {"name": "subnet_id", "in": "query", "type": "string", "description": "Service gateway subnet ID"},
        {"name": "limit", "in": "query", "type": "integer", "description": "Maximum items per page (default: all)"},
        {"name": "marker", "in": "query", "type": "string", "description": "Last service gateway ID of the previous page"},
        {"name": "page_reverse", "in": "query", "type": "boolean", "description": "Page backwards"},
        {"name": "sort_key", "in": "query", "type": "string", "description": "Sort key"},
        {"name": "sort_dir", "in": "query", "type": "string", "description": "asc or desc, paired with sort_key"}
      ]
    }
  ]
}
